# HalisAI - bien moi truong
# Copy file nay thanh .env roi dien gia tri that

# Web
APP_BASE_URL=http://localhost:3000
BIND_ADDR=0.0.0.0:3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/halisai

# Google OAuth (tao tai console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI gateway
AI_BASE_URL=https://api.kilo.ai/api/gateway
AI_MODEL=kilo-auto/free
AI_MAX_OUTPUT_TOKENS=32768

# Danh sach email tu dong len admin, ngan cach bang dau phay
ADMIN_EMAILS=

# Chi bat khi phat trien: cho phep /dev/login tao user gia
DEV_LOGIN=false
